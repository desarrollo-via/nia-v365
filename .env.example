# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── MongoDB Atlas ────────────────────────────────────
MONGO_URI=mongodb+srv://nia_user:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=nia_db

# ── API ViaIndustrial ────────────────────────────────
VIA_BASE_URL=https://viaindustrial.com/api

# ── WhatsApp Business (opcional) ─────────────────────
WHATSAPP_VERIFY_TOKEN=token_que_defines_tu
WHATSAPP_APP_SECRET=secret_del_app_de_meta

# ── Conector Bitrix (permanece bloqueado en off) ─────
NIA_BITRIX_MODE=off
NIA_BITRIX_DOMAIN=
NIA_BITRIX_MEMBER_ID=
NIA_BITRIX_APPLICATION_TOKEN=
NIA_BITRIX_REVIEW_TOKEN=
NIA_BITRIX_CLIENT_ID=
NIA_BITRIX_CLIENT_SECRET=
NIA_BITRIX_INSTALLATION_ENABLED=false
NIA_BITRIX_EVENTS_COLLECTION=nia_bitrix_events
NIA_BITRIX_INSTALLATIONS_COLLECTION=nia_bitrix_installations
NIA_BITRIX_PILOT_ENABLED=false
NIA_BITRIX_PILOT_EMERGENCY_STOP=true
NIA_BITRIX_PILOT_RULES_JSON=[]

# ── Logs ─────────────────────────────────────────────
LOG_LEVEL=INFO
